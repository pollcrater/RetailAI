# Copy this file to .env and fill in values.

# App
APP_NAME=RetailAI
APP_ENV=dev
LOG_LEVEL=INFO
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Reliability
# MAX_RETRIES=3
# TIMEOUT_SECONDS=30

# Data paths
DATA_DIR=./data
# OUTPUT_DIR=./examples/example_outputs
# DB_PATH=./data/retail_sales.duckdb

# LLM / API keys (examples)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=

# Optional Azure AD auth (client credentials) for Azure OpenAI
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: override the test prompt used by scripts\test_azure_openai_langchain.py
# AZURE_OPENAI_TEST_PROMPT=Say 'OK' and the current year.

# Corporate network / proxy (optional)
# HTTPS_PROXY=http://proxy.mycorp.local:8080
# HTTP_PROXY=http://proxy.mycorp.local:8080

# Corporate TLS interception (optional)
# Point this to a PEM bundle that includes your corporate root CA (e.g., Zscaler).
# SSL_CERT_FILE=C:\\path\\to\\corp-ca-bundle.pem

